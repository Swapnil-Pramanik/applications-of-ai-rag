# Copy to .env and fill in. Never commit the real .env.

# Which hosted LLM answers questions and writes source guides: groq (default) or gemini.
# LLM_PROVIDER=groq

# Groq (free tier, open-weight gpt-oss-120b, ~1,000 requests/day). GROQ_KEY also works.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini (free tier, 20 requests/day) — only needed with LLM_PROVIDER=gemini.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=LOW
